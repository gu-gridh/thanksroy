<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');

$labelInfo = $this->fallbackSetting('property_label_information', ['site', 'global'], 'none');
$showLocale = (bool) $this->fallbackSetting('show_locale_label', ['site'], true);
$filterLocale = (bool) $this->fallbackSetting('filter_locale_values', ['site'], false);
$showValueAnnotations = (bool) $this->fallbackSetting('show_value_annotations', ['site'], true);
$lang = $this->lang();

$filterLocaleCallback = function ($value) use ($lang) {
    $valueLang = $value->lang();
    return $valueLang == '' || strcasecmp($valueLang, $lang) === 0;
};

$relatedPropertyLabels = [];

$relatedTerms = [
    'dcterms:spatial',
    'bf:temporalCoverage',
    'dcterms:type',
];
foreach ($relatedTerms as $relatedTerm) {
    try {
        $propertyResource = $this->api()->searchOne('properties', ['term' => $relatedTerm])->getContent();
        $relatedPropertyLabels[$relatedTerm] = $translate($propertyResource->label());
    } catch (\Exception $e) {
        $relatedPropertyLabels[$relatedTerm] = $relatedTerm;
    }
}
?>

<dl>
<?php
foreach ($values as $term => $propertyData):
    $propertyValues = $propertyData['values'];
    if ($filterLocale) {
        $propertyValues = array_filter($propertyValues, $filterLocaleCallback);
    }
    if (!$propertyValues) {
        continue;
    }
    $property = $propertyData['property'];
    $propertyLabel = $propertyData['alternate_label'] ?: $translate($property->label());
    if ('term' === $labelInfo) {
        $propertyTerm = $property->term();
    } elseif ('vocab' === $labelInfo) {
        $propertyTerm = $property->vocabulary()->label();
    } else {
        $propertyTerm = null;
    }
?>
    <div class="property">
        <dt>
        <?php echo $escape($propertyLabel); ?>
        <?php if ($propertyTerm !== null): ?>
        <span class="field-term">(<?php echo $escape($propertyTerm); ?>)</span>
        <?php endif; ?>
        </dt>
        <?php foreach ($propertyValues as $value): ?>
        <?php
        $valueType = $value->type();
        $valueLang = $value->lang();
        $valueAnnotation = $value->valueAnnotation();
        $class = ['value'];
        if ('resource' == $valueType || strpos($valueType, 'resource') !== false) {
            $class[] = 'resource';
            $valueResource = $value->valueResource();
            if ($valueResource) {
                $class[] = $escape($valueResource->resourceName());
            }
        } elseif ('uri' == $valueType) {
            $class[] = 'uri';
        }
        ?>
        <dd class="<?php echo implode(' ', $class); ?>" lang="<?php echo $escape($valueLang); ?>">
    <?php if ($showLocale && $valueLang): ?>
    <span class="language"><?php echo $valueLang; ?></span>
    <?php endif; ?>

    <?php if ($valueAnnotation && $showValueAnnotations): ?>
        <div class="annotation">
            <?php echo $valueAnnotation->displayValues(); ?>
        </div>
    <?php endif; ?>

    <div class="value-content">
        <?php
        $renderedCustom = false;

        if (strpos($valueType, 'resource') !== false && $value->valueResource()) {
            $related = $value->valueResource();

            $fields = [
                'dcterms:spatial',
                'bf:temporalCoverage',
                'dcterms:type',
            ];

            // Collect visible related values first.
            $visibleRelatedFields = [];

            foreach ($fields as $term) {
                $relatedValues = $related->value($term, ['all' => true]);

                if (!is_array($relatedValues) || empty($relatedValues)) {
                    continue;
                }

                $usableValues = [];
                foreach ($relatedValues as $relatedValue) {
                    if (is_object($relatedValue) && method_exists($relatedValue, 'asHtml')) {
                        $usableValues[] = $relatedValue;
                    }
                }

                if (!empty($usableValues)) {
                    $visibleRelatedFields[$term] = $usableValues;
                }
            }

            // Only use custom output if we have something real to show.
            if (!empty($visibleRelatedFields)) {
                $renderedCustom = true;

                echo '<div class="related-main">';
                echo '<a href="' . $escape($related->siteUrl()) . '">';
                echo $escape($related->displayTitle());
                echo '</a>';
                echo '</div>';

                echo '<div class="related-resource-meta">';

                foreach ($visibleRelatedFields as $term => $usableValues) {
                    try {
                        $propertyResource = $this->api()->searchOne('properties', ['term' => $term])->getContent();
                        $label = $propertyResource ? $translate($propertyResource->label()) : $term;
                    } catch (\Exception $e) {
                        $label = $term;
                    }

                    echo '<div class="related-field related-field-' . str_replace([':', '_'], '-', $term) . '">';
                    echo '<span class="related-label">' . $escape($label) . ':</span>';

                    foreach ($usableValues as $relatedValue) {
                        echo '<div class="related-value">' . $relatedValue->asHtml() . '</div>';
                    }

                    echo '</div>';
                }

                echo '</div>';
            }
        }

        // Fallback to normal Omeka output if no visible related values were available.
        if (!$renderedCustom) {
            echo $filterLocale ? $value->asHtml($lang) : $value->asHtml();
        }
        ?>
    </div>

    <?php if (!$value->isPublic()): ?>
        <span class="o-icon-private" role="img"
            title="<?php echo $this->escapeHtml($translate('Private')); ?>"
            aria-label="<?php echo $this->escapeHtml($translate('Private')); ?>">
        </span>
    <?php endif; ?>

    <?php $this->trigger('view.show.value', ['value' => $value]); ?>
</dd>

        <?php endforeach; ?>
    </div>
<?php endforeach; ?>
</dl>
