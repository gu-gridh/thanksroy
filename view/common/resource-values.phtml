<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');

$labelInfo = $this->fallbackSetting('property_label_information', ['site', 'global'], 'none');
$showLocale = (bool) $this->fallbackSetting('show_locale_label', ['site'], true);
$filterLocale = (bool) $this->fallbackSetting('filter_locale_values', ['site'], false);
$showValueAnnotations = (bool) $this->fallbackSetting('show_value_annotations', ['site'], true);
$lang = $this->lang();

$customRelatedPropertyTerm = 'rico:isAssociatedWithEvent';

$relatedTerms = [
    'dcterms:spatial',
    'bf:temporalCoverage',
    'dcterms:type',
];

$relatedPropertyLabels = [];
foreach ($relatedTerms as $relatedTerm) {
    try {
        $relatedProperty = $this->api()->searchOne('properties', ['term' => $relatedTerm])->getContent();
        $relatedPropertyLabels[$relatedTerm] = $relatedProperty
            ? $translate($relatedProperty->label())
            : $relatedTerm;
    } catch (\Exception $e) {
        $relatedPropertyLabels[$relatedTerm] = $relatedTerm;
    }
}

$filterLocaleCallback = function ($value) use ($lang) {
    $valueLang = $value->lang();
    return $valueLang === '' || strcasecmp($valueLang, $lang) === 0;
};
?>

<dl>
<?php foreach ($values as $unusedTerm => $propertyData): ?>
    <?php
    $property = $propertyData['property'];
    $currentPropertyTerm = $property->term();
    $showRelatedEventMeta = ($currentPropertyTerm === $customRelatedPropertyTerm);

    $propertyValues = $propertyData['values'];
    if ($filterLocale) {
        $propertyValues = array_filter($propertyValues, $filterLocaleCallback);
    }
    if (empty($propertyValues)) {
        continue;
    }

    $propertyLabel = $propertyData['alternate_label'] ?: $translate($property->label());

    if ($labelInfo === 'term') {
        $propertyInfo = $property->term();
    } elseif ($labelInfo === 'vocab') {
        $propertyInfo = $property->vocabulary()->label();
    } else {
        $propertyInfo = null;
    }
    ?>

    <div class="property">
        <dt>
            <?php echo $escape($propertyLabel); ?>
            <?php if ($propertyInfo !== null): ?>
                <span class="field-term">(<?php echo $escape($propertyInfo); ?>)</span>
            <?php endif; ?>
        </dt>

        <?php foreach ($propertyValues as $value): ?>
            <?php
            $valueType = $value->type();
            $valueLang = $value->lang();
            $valueAnnotation = $value->valueAnnotation();
            $valueResource = null;

            $classes = ['value'];

            if ($valueType === 'resource' || strpos($valueType, 'resource') !== false) {
                $classes[] = 'resource';
                $valueResource = $value->valueResource();
                if ($valueResource) {
                    $classes[] = $escape($valueResource->resourceName());
                }
            } elseif ($valueType === 'uri') {
                $classes[] = 'uri';
            }
            ?>

            <dd class="<?php echo implode(' ', $classes); ?>" lang="<?php echo $escape($valueLang); ?>">
                <?php if ($showLocale && $valueLang): ?>
                    <span class="language"><?php echo $valueLang; ?></span>
                <?php endif; ?>

                <?php if ($valueAnnotation && $showValueAnnotations): ?>
                    <div class="annotation">
                        <?php echo $valueAnnotation->displayValues(); ?>
                    </div>
                <?php endif; ?>

                <div class="value-content">
                    <?php
                    $renderedCustom = false;

                    if ($valueResource && $showRelatedEventMeta) {
                        $visibleRelatedFields = [];

                        foreach ($relatedTerms as $relatedTerm) {
                            $relatedValues = $valueResource->value($relatedTerm, ['all' => true]);

                            if (!is_array($relatedValues) || empty($relatedValues)) {
                                continue;
                            }

                            $usableValues = [];
                            foreach ($relatedValues as $relatedValue) {
                                if (is_object($relatedValue) && method_exists($relatedValue, 'asHtml')) {
                                    $usableValues[] = $relatedValue->asHtml();
                                }
                            }

                            if (!empty($usableValues)) {
                                $visibleRelatedFields[$relatedTerm] = $usableValues;
                            }
                        }

                        if (!empty($visibleRelatedFields)) {
                            $renderedCustom = true;

                            echo '<div class="related-main">';
                            echo '<a href="' . $escape($valueResource->siteUrl()) . '">';
                            echo $escape($valueResource->displayTitle());
                            echo '</a>';
                            echo '</div>';

                            echo '<div class="related-resource-meta">';
                            foreach ($visibleRelatedFields as $relatedTerm => $usableValues) {
                                $label = $relatedPropertyLabels[$relatedTerm] ?? $relatedTerm;

                                echo '<div class="related-field related-field-' . str_replace([':', '_'], '-', $relatedTerm) . '">';
                                echo '<span class="related-label">' . $escape($label) . ':</span> ';
                                echo '<span class="related-value">' . implode(', ', $usableValues) . '</span>';
                                echo '</div>';
                            }
                            echo '</div>';
                        }
                    }

                    if (!$renderedCustom) {
                        echo $filterLocale ? $value->asHtml($lang) : $value->asHtml();
                    }
                    ?>
                </div>

                <?php if (!$value->isPublic()): ?>
                    <span class="o-icon-private" role="img"
                        title="<?php echo $escape($translate('Private')); ?>"
                        aria-label="<?php echo $escape($translate('Private')); ?>">
                    </span>
                <?php endif; ?>

                <?php $this->trigger('view.show.value', ['value' => $value]); ?>
            </dd>
        <?php endforeach; ?>
    </div>
<?php endforeach; ?>
</dl>